# Copy to config/lab.env and edit before running.

# Ubuntu PC 1 (WAN emulator)
WAN_IF=enx001122334455
WAN_NS=ns-wan
WAN_IP=10.10.0.1/24
WAN_DHCP_START=10.10.0.2
WAN_DHCP_END=10.10.0.20
WAN_DHCP_ROUTER=10.10.0.1

# Ubuntu PC 2 (LAN/STB emulator)
LAN_IF=enx006655443322
DUT_LAN_GW=192.168.1.1
LAN_PREFIX=192.168.1
STB_COUNT=4
STB_BASE_HOST=101

# Multicast defaults
MCAST_GROUP=239.10.0.1
MCAST_PORT=5001
MCAST_PPS=1000
MCAST_PAYLOAD=1200
MCAST_DURATION=60
MCAST_TTL=16

# Safety limits
MAX_QUERY_PPS=250
MAX_TEST_DURATION=86400

# Runtime path
RUNTIME_DIR=/tmp/ra304-lab
